{
  "expo": {
    "name": "KDSトレーディングカードゲーム",
    "slug": "kds-card-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kdscardgame",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.kds946.cardgame",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:kds-taisen.fly.dev"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#153a86",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kds946.cardgame",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://keisuke1113s.github.io/kds-card-game"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#153a86",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "実物カードのQRコードを読み取ってカードを登録するためにカメラを使用します。"
        }
      ],
      "expo-asset",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "教習生免許証の顔写真に使う画像を選ぶために写真ライブラリを使用します。"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/kds-card-game"
    },
    "primaryColor": "#1565c0",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa1e0584-04f7-4217-91a7-b559cce6225b"
      }
    },
    "owner": "keisuke1113"
  }
}
